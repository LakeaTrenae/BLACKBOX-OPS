# Schwab API — get these from developer.schwab.com
SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_app_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1
SCHWAB_ACCOUNT_ID=your_account_hash_here   # optional — only needed for order placement

# Alerts — all optional
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1xxxxxxxxxx
TWILIO_TO=+1xxxxxxxxxx

DISCORD_WEBHOOK_URL=

ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_PASSWORD=your_app_password_here
